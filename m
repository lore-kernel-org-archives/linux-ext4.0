 }
 
+# Check that dump/restore is present
+_require_dump_restore()
+{
+	_require_command $E2FS_DUMP_PROG "dump"
+	_require_command $E2FS_RESTORE_PROG "restore"
+}
+
 # Does freeze work on this fs?
 _require_freeze()
 {
